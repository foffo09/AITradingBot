ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Credential names are documentation only. Inject secrets into the process environment.
# ProviderSettings and the native testnet runner do not load credentials from this file.
TRADING_MODE=paper
AUTO_TRADE=false
BASE_CURRENCY=USD
INITIAL_CAPITAL_EUR=100.0
# Legacy dashboard reference conversion, not a current FX quote.
EUR_USD_RATE=1.09
SHORT_WINDOW=10
LONG_WINDOW=30
RISK_MAX_TRADE_FRACTION=0.20
RISK_MAX_EXPOSURE_FRACTION=0.50
DAILY_LOSS_LIMIT_PCT=0.05
MAX_POSITIONS=3
PAPER_MAX_DAILY_ORDERS=5
LOG_LEVEL=INFO
ALLOWED_MARKET_HOURS_ONLY=true
COMMISSION_BPS=5.0
SPREAD_BPS=0.0
SLIPPAGE_BPS=5.0

# OMEGA: no native order is sent by the dashboard. Local paper is the default.
# live = public/entitled real data; synthetic = explicit offline replay.
OMEGA_DATA_MODE=live
OMEGA_ENABLE_NATIVE_ORDERS=false
OMEGA_ENABLE_LIVE_ORDERS=false
# Legacy live flags cannot enable funded/mainnet writes.
QUOTE_MAX_AGE_SECONDS=60
REQUEST_TIMEOUT_SECONDS=8

# Public data network is independent of native order execution network.
CRYPTO_PROVIDER=hyperliquid
CRYPTO_DATA_NETWORK=mainnet
CRYPTO_EXECUTION_NETWORK=testnet
HYPERLIQUID_COIN=BTC
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_ACCOUNT_ADDRESS=
HL_TESTNET_NETWORK=testnet
HL_TESTNET_MAX_ORDER_USD=25
CCXT_SYMBOL=BTC/USDT:USDT
# Inject TESTNET keys through process environment when CRYPTO_EXECUTION_NETWORK=testnet.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BYBIT_API_KEY=
BYBIT_SECRET_KEY=

# Priority: custom RPC -> Helius -> QuickNode -> public Solana mainnet.
# URLs containing credentials are treated as secrets and never exposed in telemetry.
SOLANA_RPC_URL=
SOLANA_WS_URL=
HELIUS_API_KEY=
QUICKNODE_RPC_URL=
QUICKNODE_WS_URL=
SOLANA_TOKEN_MINT=So11111111111111111111111111111111111111112
JUPITER_API_KEY=
# Current documented Metis quote/unsigned-swap schema; override for a compatible v6 gateway.
JUPITER_BASE_URL=https://api.jup.ag/swap/v1

# ALPACA_API_KEY and ALPACA_SECRET_KEY are defined above; never paste real keys here.
ALPACA_PAPER=true
# Exact OCC contract symbol required for option quotes. Blank watches SPY as a nontradable proxy.
OPTIONS_SYMBOL=
OPTIONS_UNDERLYING=SPY
BIOTECH_SYMBOL=MRNA
# A continuous futures series is a monitoring proxy, not an executable dated contract.
FUTURES_YAHOO_SYMBOL=CL=F

# TWS or IB Gateway must already be running and authenticated locally.
# 7497 is the usual TWS paper port; the execution gateway also verifies IB_ACCOUNT.
IB_ENABLED=false
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=17
IB_ACCOUNT=
IB_FUTURES_SYMBOL=CL
IB_FUTURES_EXPIRY=
IB_FUTURES_EXCHANGE=NYMEX

# These feeds may require account entitlements even when an API key is free.
POLYGON_API_KEY=
POLYGON_BASE_URL=https://api.polygon.io
FINNHUB_API_KEY=

# auto selects OpenAI -> Anthropic -> configured Ollama -> deterministic fallback.
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AITradingBot",
  "version": "0.1.0",
  "identifier": "it.aitradingbot.desktop",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/aitradingbot-service"],
    "resources": {
      "../frontend/dist/": "ui/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "category": "Finance",
    "shortDescription": "Terminale analitico locale AITradingBot",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
